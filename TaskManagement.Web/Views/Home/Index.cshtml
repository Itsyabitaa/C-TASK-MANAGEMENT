@model DashboardStats
@{
    ViewData["Title"] = "Dashboard";
}
<h1 class="mb-4">Dashboard</h1>
<div class="row g-3 mb-4">
    <div class="col-md-4 col-lg-2">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Total tasks</div>
                <div class="display-6">@Model.Total</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card h-100 border-secondary shadow-sm">
            <div class="card-body">
                <div class="text-muted small">To do</div>
                <div class="display-6">@Model.Todo</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card h-100 border-primary shadow-sm">
            <div class="card-body">
                <div class="text-muted small">In progress</div>
                <div class="display-6">@Model.InProgress</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card h-100 border-success shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Done</div>
                <div class="display-6">@Model.Done</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card h-100 border-danger shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Overdue</div>
                <div class="display-6">@Model.Overdue</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-2">
        <div class="card h-100 border-warning shadow-sm">
            <div class="card-body">
                <div class="text-muted small">Due this week</div>
                <div class="display-6">@Model.DueThisWeek</div>
            </div>
        </div>
    </div>
</div>
<div class="d-flex gap-2 flex-wrap">
    <a class="btn btn-primary" asp-controller="Tasks" asp-action="Create">New task</a>
    <a class="btn btn-outline-secondary" asp-controller="Tasks" asp-action="Index">View all tasks</a>
    <a class="btn btn-outline-secondary" asp-controller="Reports" asp-action="Index">Open reports</a>
</div>
