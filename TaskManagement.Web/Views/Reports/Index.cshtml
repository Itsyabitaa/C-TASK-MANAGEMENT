@model ReportSummary
@{
    ViewData["Title"] = "Reports";
}
<h1 class="mb-4">Reports</h1>

<h2 class="h5">Counts by status</h2>
<table class="table table-sm w-auto mb-4">
    <thead>
        <tr>
            <th>Status</th>
            <th class="text-end">Count</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.CountsByStatus)
        {
            <tr>
                <td>@row.Status</td>
                <td class="text-end">@row.Count</td>
            </tr>
        }
    </tbody>
</table>

<h2 class="h5">Summary</h2>
<ul class="mb-4">
    <li><strong>Overdue (active):</strong> @Model.OverdueCount</li>
    <li><strong>Due this week (active):</strong> @Model.DueThisWeekTasks.Count</li>
</ul>

<h2 class="h5">Overdue tasks</h2>
@if (Model.OverdueTasks.Count == 0)
{
    <p class="text-muted">None.</p>
}
else
{
    <ul>
        @foreach (var t in Model.OverdueTasks)
        {
            <li>
                <a asp-controller="Tasks" asp-action="Details" asp-route-id="@t.Id">@t.Title</a>
                <span class="text-muted small">(due @t.DueDate?.ToString("u"))</span>
            </li>
        }
    </ul>
}

<h2 class="h5">Due this week</h2>
@if (Model.DueThisWeekTasks.Count == 0)
{
    <p class="text-muted">None.</p>
}
else
{
    <ul>
        @foreach (var t in Model.DueThisWeekTasks)
        {
            <li>
                <a asp-controller="Tasks" asp-action="Details" asp-route-id="@t.Id">@t.Title</a>
                <span class="text-muted small">(due @t.DueDate?.ToString("u"))</span>
            </li>
        }
    </ul>
}
