@model IReadOnlyList<TaskItem>
@{
    ViewData["Title"] = "Tasks";
    var filter = ViewBag.StatusFilter as TaskStatus?;
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Tasks</h1>
    <a class="btn btn-primary" asp-action="Create">Create task</a>
</div>
<div class="btn-group mb-3" role="group" aria-label="Filter by status">
    <a class="btn btn-sm @(filter is null ? "btn-primary" : "btn-outline-primary")" asp-action="Index">All</a>
    @foreach (TaskStatus s in Enum.GetValues<TaskStatus>())
    {
        <a class="btn btn-sm @(filter == s ? "btn-primary" : "btn-outline-primary")" asp-action="Index" asp-route-status="@s">@s</a>
    }
</div>
@if (Model.Count == 0)
{
    <p class="text-muted">No tasks yet. <a asp-action="Create">Create one</a>.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Due</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@t.Id">@t.Title</a>
                        </td>
                        <td><span class="badge bg-secondary">@t.Status</span></td>
                        <td>@t.Priority</td>
                        <td>
                            @if (t.DueDate.HasValue)
                            {
                                @t.DueDate.Value.ToString("u")
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@t.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@t.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
