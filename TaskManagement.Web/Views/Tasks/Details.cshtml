@model TaskItem
@{
    ViewData["Title"] = Model.Title;
}
<h1>@Model.Title</h1>
<dl class="row">
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Status</span></dd>
    <dt class="col-sm-3">Priority</dt>
    <dd class="col-sm-9">@Model.Priority</dd>
    <dt class="col-sm-3">Due</dt>
    <dd class="col-sm-9">@(Model.DueDate?.ToString("u") ?? "—")</dd>
    <dt class="col-sm-3">Created</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToString("u")</dd>
    <dt class="col-sm-3">Updated</dt>
    <dd class="col-sm-9">@Model.UpdatedAt.ToString("u")</dd>
    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Description) ? "—" : Model.Description)</dd>
</dl>
<div class="d-flex gap-2">
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to list</a>
</div>
