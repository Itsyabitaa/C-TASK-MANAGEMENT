@model TaskItem
@{
    ViewData["Title"] = "Delete task";
}
<h1>Delete task</h1>
<p class="lead">Are you sure you want to delete this task?</p>
<dl class="row">
    <dt class="col-sm-3">Title</dt>
    <dd class="col-sm-9">@Model.Title</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
    <dt class="col-sm-3">Due</dt>
    <dd class="col-sm-9">@(Model.DueDate?.ToString("u") ?? "—")</dd>
</dl>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>
