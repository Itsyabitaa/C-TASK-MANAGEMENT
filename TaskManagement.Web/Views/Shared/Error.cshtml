@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<h1 class="text-danger">Something went wrong</h1>
<p class="lead">An error occurred while processing your request.</p>
@if (Model.ShowRequestId)
{
    <p class="text-muted small"><strong>Request ID:</strong> @Model.RequestId</p>
}
@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-warning">@Model.Message</div>
}
<p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to dashboard</a>
</p>
